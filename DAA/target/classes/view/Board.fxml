<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<AnchorPane fx:id="root"
         prefHeight="700.0"
         prefWidth="700.0"
         styleClass="pane"
         stylesheets="@../style/Style.css,@../style/Board.css"
         xmlns="http://javafx.com/javafx/18"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="lk.ijse.dep.controller.BoardController">

    <children>

        <Group layoutX="40.0" layoutY="16.0">
            <children>
                <ImageView fitHeight="94.0"
                           fitWidth="84.0"
                           pickOnBounds="true"
                           preserveRatio="true">
                    <image>
                        <Image url="@../asset/connect-four.png"/>
                    </image>
                </ImageView>

                <Group layoutX="97.0" layoutY="5.0">
                    <children>
                        <Label layoutY="48.0"
                               prefWidth="500.0"
                               alignment="CENTER"
                               wrapText="true"
                               text="Connect 4 pieces together by forming a horizontal, vertical, or diagonal line"/>
                        <TextFlow prefHeight="32.0"
                                  prefWidth="266.0"
                                  styleClass="title">
                            <children>
                                <Text text="Connect "/>
                                <Text styleClass="four" text="4"/>
                                <Text text=" Game"/>
                            </children>
                        </TextFlow>
                    </children>
                </Group>
            </children>
        </Group>


        <Label fx:id="lblStatus"
               alignment="CENTER"
               layoutX="41.0"
               layoutY="116.0"
               prefHeight="38.0"
               prefWidth="600.0"
               text="LET'S PLAY !"
               AnchorPane.leftAnchor="40.0"
               AnchorPane.rightAnchor="40.0"/>


        <Group layoutX="220.0" layoutY="160.0">
    		<children>
		        <JFXButton fx:id="btnHint"
                   text="HINT"
                   prefWidth="110"
                   prefHeight="40"
                   layoutX="0"
                   layoutY="0"
                   onAction="#btnHintOnAction"/>

        		<JFXButton fx:id="btnUndo"
                   text="UNDO"
                   prefWidth="110"
                   prefHeight="40"
                   layoutX="140"
                   layoutY="0"
                   onAction="#btnUndoOnAction"/>
		    </children>
		</Group>
        <Group fx:id="grpCols"
               layoutX="32.0"
               layoutY="200.0"
               AnchorPane.bottomAnchor="45.0"
               AnchorPane.leftAnchor="40.0"
               AnchorPane.rightAnchor="40.0">
            <children>
                <VBox fx:id="col0"
                      alignment="BOTTOM_CENTER"
                      prefHeight="440.0"
                      prefWidth="100.0"
                      spacing="2.0">
                    <padding>
                        <Insets bottom="2.0"/>
                    </padding>
                    <styleClass>
                        <String fx:value="col"/>
                        <String fx:value="col-first"/>
                        <String fx:value="col-human"/>
                    </styleClass>
                </VBox>

                <VBox fx:id="col1"
                      alignment="BOTTOM_CENTER"
                      layoutX="100.0"
                      prefHeight="440.0"
                      prefWidth="100.0"
                      spacing="2.0">
                    <padding>
                        <Insets bottom="2.0"/>
                    </padding>
                    <styleClass>
                        <String fx:value="col"/>
                        <String fx:value="col-human"/>
                    </styleClass>
                </VBox>

                <VBox fx:id="col2"
                      alignment="BOTTOM_CENTER"
                      layoutX="200.0"
                      prefHeight="440.0"
                      prefWidth="100.0"
                      spacing="2.0">
                    <padding>
                        <Insets bottom="2.0"/>
                    </padding>
                    <styleClass>
                        <String fx:value="col"/>
                        <String fx:value="col-human"/>
                    </styleClass>
                </VBox>

                <VBox fx:id="col3"
                      alignment="BOTTOM_CENTER"
                      layoutX="300.0"
                      prefHeight="440.0"
                      prefWidth="100.0"
                      spacing="2.0">
                    <padding>
                        <Insets bottom="2.0"/>
                    </padding>
                    <styleClass>
                        <String fx:value="col"/>
                        <String fx:value="col-human"/>
                    </styleClass>
                </VBox>

                <VBox fx:id="col4"
                      alignment="BOTTOM_CENTER"
                      layoutX="400.0"
                      prefHeight="440.0"
                      prefWidth="100.0"
                      spacing="2.0">
                    <padding>
                        <Insets bottom="2.0"/>
                    </padding>
                    <styleClass>
                        <String fx:value="col"/>
                        <String fx:value="col-human"/>
                    </styleClass>
                </VBox>

                <VBox fx:id="col5"
                      alignment="BOTTOM_CENTER"
                      layoutX="500.0"
                      prefHeight="440.0"
                      prefWidth="100.0"
                      spacing="2.0">
                    <padding>
                        <Insets bottom="2.0"/>
                    </padding>
                    <styleClass>
                        <String fx:value="col"/>
                        <String fx:value="col-last"/>
                        <String fx:value="col-human"/>
                    </styleClass>
                </VBox>
            </children>
        </Group>


        <Pane fx:id="pneOver"
              layoutX="39.0"
              layoutY="200.0"
              prefHeight="440.0"
              prefWidth="600.0"
              managed="false"
              visible="false">
            <children>
                <JFXButton fx:id="btnPlayAgain"
                           layoutX="170.0"
                           layoutY="201.0"
                           text="PLAY AGAIN"
                           onAction="#btnPlayAgainOnAction"/>
                <JFXButton layoutX="310.0"
                           layoutY="201.0"
                           text="VIEW SCORECARD"
                           onAction="#btnScorecardOnAction"/>
            </children>
        </Pane>


        <Label layoutX="138.0"
               layoutY="670.0"
               styleClass="small"
               text="Copyright © 2022 DEP. All Rights Reserved. This project is licensed under the MIT license."/>

    </children>
</AnchorPane>